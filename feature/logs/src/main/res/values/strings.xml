<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
        App bar title: how many rows Paging holds of how many the query matches, both pre-grouped
        ("100,000") before they are inserted. It replaces a fixed product name because the numbers
        that describe the active query are worth more in the most prominent position than one that
        never changes, and the pair is routinely different by three orders of magnitude — which is
        exactly why neither is shown without the other.
    -->
    <string name="log_viewer_title_count">%1$s of %2$s Logs</string>
    <!-- Shown until the aggregate for the current query has been counted; never a stale total. -->
    <string name="log_viewer_title_counting">Counting logs…</string>

    <!--
        Sort toggle. The icon is the same in both directions, so the label carries the order in
        effect and the one a tap produces — a toggle that only names the current state leaves the
        result of pressing it to be guessed.
    -->
    <string name="log_viewer_sort_action_newest_first">Sorted newest first. Change to oldest first.</string>
    <string name="log_viewer_sort_action_oldest_first">Sorted oldest first. Change to newest first.</string>

    <!--
        Search action. The field is hidden until it is asked for, but the text survives hiding it,
        so the collapsed state has its own label for a search that is still narrowing the result.
    -->
    <string name="log_viewer_search_action">Search logs</string>
    <string name="log_viewer_search_active_action">Search logs, search active</string>
    <string name="log_viewer_search_close_action">Close search</string>

    <!--
        Filter entry. The icon carries no text, so the active count is folded into its label rather
        than announced as a bare number beside it.
    -->
    <string name="log_viewer_filter_action">Filter</string>
    <plurals name="log_viewer_filter_action_active">
        <item quantity="one">Filter, %1$d active filter</item>
        <item quantity="other">Filter, %1$d active filters</item>
    </plurals>

    <!-- Severity summary card -->
    <!-- "percent" does not inflect in English, so a <plurals> resource adds no value here. -->
    <string name="log_viewer_error_density" tools:ignore="PluralsCandidate">%1$d%% Error Density</string>
    <!-- "All matching logs", not the loaded ones: the aggregate covers the complete result. -->
    <string name="log_viewer_error_density_caption">ERROR + FATAL / all matching logs</string>
    <string name="log_viewer_error_density_pending">Counting matching logs…</string>

    <!-- Retryable launch-refresh failure. Every cause maps to this one copy. -->
    <string name="log_viewer_error_title">Unable to load logs</string>
    <string name="log_viewer_error_message">We couldn\'t fetch logs from the server.</string>
    <!--
        Shown after the failure dialog is dismissed. It is the only remaining way to retry, and it
        keeps the screen from presenting a snapshot the refresh never managed to replace as current.
    -->
    <string name="log_viewer_stale_snapshot">These logs may be out of date.</string>
    <!-- One label for both retry affordances: the stale-snapshot notice and the append footer. -->
    <string name="log_viewer_retry_action">Retry</string>

    <!-- Paging append states, rendered as the last item of the list so loaded rows stay visible. -->
    <string name="log_viewer_append_loading">Loading more logs…</string>
    <string name="log_viewer_append_error_title">Couldn\'t load more</string>
    <string name="log_viewer_append_error_message">Please try again.</string>

    <!--
        Paging refresh failure: reading the query out of the stored snapshot failed, which is a
        different thing from the launch refresh failing to replace that snapshot. Generic copy, per
        ARCHITECTURE.md: the UI never names the infrastructure cause.
    -->
    <string name="log_viewer_page_error_title">Couldn\'t load results</string>
    <string name="log_viewer_page_error_message">Please try again.</string>

    <!-- Filtered-empty result -->
    <string name="log_viewer_no_results_title">No matching logs</string>
    <string name="log_viewer_no_results_message">Try a different search term or fewer filters.</string>
</resources>
